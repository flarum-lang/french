{
	"name": "flarum-lang/french",
	"description": "French Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/french",
	"license": "MIT",
	"authors": [
		{
			"name": "Wlork",
			"homepage": "https://github.com/Wlork",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/french/issues",
		"forum": "https://discuss.flarum.org/d/615",
		"source": "https://github.com/flarum-lang/french"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "French",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#fff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "fr",
			"title": "Français"
		}
	}
}
